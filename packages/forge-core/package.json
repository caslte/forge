{
  "name": "@forge/core",
  "version": "0.1.0",
  "private": true,
  "description": "forge 引擎层：纯 Node，传输无关接口（方法+事件），项目/会话树组织（骨架）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./markdown": {
      "types": "./dist/markdown/renderMarkdown.d.ts",
      "import": "./dist/markdown/renderMarkdown.js"
    },
    "./model": {
      "types": "./dist/model/modelService.d.ts",
      "import": "./dist/model/modelService.js"
    },
    "./multiwin-layout": {
      "types": "./dist/multiwin/windowLayout.d.ts",
      "import": "./dist/multiwin/windowLayout.js"
    },
    "./side-by-side-diff": {
      "types": "./dist/tool/sideBySideDiff.d.ts",
      "import": "./dist/tool/sideBySideDiff.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  },
  "dependencies": {
    "@types/sanitize-html": "^2.16.1",
    "highlight.js": "^11.12.0",
    "marked": "^15.0.12",
    "sanitize-html": "^2.17.7"
  }
}
