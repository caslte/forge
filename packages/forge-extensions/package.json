{
  "name": "@forge/extensions",
  "version": "0.1.0",
  "private": true,
  "description": "forge 业务能力：pi 扩展承载（TS，jiti 加载）（骨架，仅占位）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@forge/core": "*",
    "typebox": "1.3.7"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test"
  },
  "engines": {
    "node": ">=22"
  }
}
