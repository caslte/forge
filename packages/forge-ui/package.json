{
  "name": "@forge/ui",
  "version": "0.1.0",
  "private": true,
  "description": "forge 前端：Vue 3 + Vite，适配 Electron + forge-core IPC",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@forge/core": "*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "mermaid": "^11.17.1",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "vite": "^5.4.21",
    "vue-tsc": "^2.2.12"
  }
}
