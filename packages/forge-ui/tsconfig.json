{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "types": ["vite/client"],
    "noEmit": true,
    "verbatimModuleSyntax": false,
    "erasableSyntaxOnly": false,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": false
  },
  "include": ["src"]
}
