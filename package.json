{
  "name": "forge",
  "version": "0.1.0",
  "private": true,
  "description": "forge 桌面项目工作台（npm workspaces 根）",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/forge-core",
    "packages/forge-desktop",
    "packages/forge-ui",
    "packages/forge-extensions"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "bump:pi": "node scripts/bump-pi.mjs",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22"
  }
}